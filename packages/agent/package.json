{
  "name": "@hire-me-mcp/agent",
  "version": "1.0.0",
  "private": true,
  "description": "Embedded Mastra interview agent runtime with a swappable AI SDK model provider",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./citations": {
      "types": "./dist/citations.d.ts",
      "default": "./dist/citations.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bash ../../scripts/biome-check.sh check .",
    "format": "bash ../../scripts/biome-check.sh format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "tsx scripts/smoke.ts",
    "eval:agent": "tsx src/evals/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.40",
    "@ai-sdk/google": "4.0.48",
    "@hire-me-mcp/core": "workspace:*",
    "@mastra/core": "1.61.0",
    "ai": "7.0.71",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
