{
  "name": "@hire-me-mcp/core",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-free domain layer",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./slugify": {
      "types": "./dist/slugify.d.ts",
      "default": "./dist/slugify.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "default": "./dist/analytics/index.js"
    },
    "./embedding": {
      "types": "./dist/embedding/index.d.ts",
      "default": "./dist/embedding/index.js"
    },
    "./search-career": {
      "types": "./dist/search-career.d.ts",
      "default": "./dist/search-career.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bash ../../scripts/biome-check.sh check .",
    "format": "bash ../../scripts/biome-check.sh format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "ingest": "tsx src/ingest/cli.ts",
    "eval:retrieval": "tsx src/eval-retrieval/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.50",
    "@hire-me-mcp/career-data": "workspace:*",
    "ai": "7.0.77",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
