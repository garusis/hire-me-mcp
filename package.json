{
  "name": "hire-me-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio as an API — monorepo root",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "prepare": "lefthook install --force",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "bash scripts/biome-check.sh format --write .",
    "format:check": "bash scripts/biome-check.sh format .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:preview": "playwright test -c playwright.preview.config.ts",
    "test:e2e:preview:ui": "playwright test -c playwright.preview.config.ts --ui",
    "lighthouse": "node scripts/lighthouse/build-config.mjs .lighthouserc.local.json && lhci autorun --config=.lighthouserc.local.json",
    "test:mcp": "pnpm --filter @hire-me-mcp/web test:mcp",
    "eval:agent": "pnpm --filter @hire-me-mcp/agent eval:agent",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run validate",
    "lint:content": "turbo run lint:content",
    "validate:lefthook": "node scripts/lefthook/validate-config.mjs",
    "generate:connect": "turbo run generate:connect --filter=@hire-me-mcp/web",
    "generate:connect:check": "turbo run generate:connect:check --filter=@hire-me-mcp/web",
    "generate:llms": "turbo run generate:llms --filter=@hire-me-mcp/web",
    "generate:llms:check": "turbo run generate:llms:check --filter=@hire-me-mcp/web"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.9",
    "@hire-me-mcp/core": "workspace:*",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.11",
    "lefthook": "2.1.10",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
