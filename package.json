{
  "name": "hire-me-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio as an API \u2014 monorepo root",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "uuid@<11.1.1": ">=11.1.1",
      "tmp": ">=0.2.6",
      "sharp": ">=0.35.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-56876"
      ]
    }
  },
  "scripts": {
    "prepare": "lefthook install --force",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "bash scripts/biome-check.sh format --write .",
    "format:check": "bash scripts/biome-check.sh format .",
    "audit": "pnpm audit --audit-level=high --ignore-unfixable",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:preview": "playwright test -c playwright.preview.config.ts --project=chromium --project=chromium-scripted-chat --project=chromium-latency",
    "test:e2e:preview:ui": "playwright test -c playwright.preview.config.ts --ui",
    "test:e2e:preview:live": "playwright test -c playwright.preview.config.ts --project=chromium-live-model",
    "lighthouse": "node scripts/lighthouse/build-config.mjs .lighthouserc.local.json && lhci autorun --config=.lighthouserc.local.json",
    "test:mcp": "pnpm --filter @hire-me-mcp/web test:mcp",
    "ingest": "pnpm --filter @hire-me-mcp/core ingest",
    "eval:agent": "pnpm --filter @hire-me-mcp/agent eval:agent",
    "eval:retrieval": "pnpm --filter @hire-me-mcp/core eval:retrieval",
    "certify:production": "node scripts/certify-production.mjs",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run validate",
    "lint:content": "turbo run lint:content",
    "validate:lefthook": "node scripts/lefthook/validate-config.mjs",
    "generate:connect": "turbo run generate:connect --filter=@hire-me-mcp/web",
    "generate:connect:check": "turbo run generate:connect:check --filter=@hire-me-mcp/web",
    "generate:llms": "turbo run generate:llms --filter=@hire-me-mcp/web",
    "generate:llms:check": "turbo run generate:llms:check --filter=@hire-me-mcp/web",
    "generate:cv": "turbo run generate:cv --filter=@hire-me-mcp/web",
    "docs-rot:snippets": "node scripts/ci/docs-rot/check-snippets.mjs",
    "docs-rot:links": "node scripts/ci/docs-rot/check-links.mjs",
    "docs-rot:test": "node --test scripts/ci/docs-rot/*.test.mjs",
    "ci:neon-cleanup": "node scripts/ci/neon-branch-cleanup.mjs",
    "ci:neon-cleanup:test": "node --test scripts/ci/neon-branch-cleanup.test.mjs scripts/ci/retrieval-eval/summary.test.mjs",
    "ci:eval-relevance:test": "node --test scripts/ci/eval-relevance.test.mjs",
    "ci:gemini-slot:test": "node --test scripts/ci/gemini-slot.test.mjs",
    "ci:scripts:test": "node --test scripts/ci/*.test.mjs scripts/ci/docs-rot/*.test.mjs scripts/ci/retrieval-eval/*.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@hire-me-mcp/core": "workspace:*",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.11",
    "lefthook": "2.1.10",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
