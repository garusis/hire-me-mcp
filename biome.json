{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/**",
      "tooling/**",
      "*.json",
      "vitest.config.base.ts",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/node_modules",
      "!**/coverage",
      "!**/next-env.d.ts",
      "!**/*.tsbuildinfo",
      "!**/pnpm-lock.yaml",
      "!**/src/content/__fixtures__"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noDefaultExport": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/app/**/{page,layout,loading,error,not-found,template,default,global-error}.tsx",
        "apps/web/app/**/route.ts",
        "**/next.config.ts",
        "**/vitest.config.ts",
        "vitest.config.base.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/**", "!apps/web/src/lib/content/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@hire-me-mcp/career-data": "apps/web reads career content only through src/lib/content/ (issue #16) — import from packages/core (via src/lib/content) instead of the data package directly."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "packages/core is framework-free — React belongs in apps/web.",
                  "react-dom": "packages/core is framework-free — React belongs in apps/web.",
                  "next": "packages/core is framework-free — Next.js belongs in apps/web.",
                  "express": "packages/core is framework-free — HTTP frameworks belong in apps/web.",
                  "fastify": "packages/core is framework-free — HTTP frameworks belong in apps/web.",
                  "koa": "packages/core is framework-free — HTTP frameworks belong in apps/web.",
                  "http": "packages/core is framework-free — avoid Node-only server APIs.",
                  "node:http": "packages/core is framework-free — avoid Node-only server APIs.",
                  "https": "packages/core is framework-free — avoid Node-only server APIs.",
                  "node:https": "packages/core is framework-free — avoid Node-only server APIs."
                },
                "patterns": [
                  {
                    "group": ["next/*", "react/*", "react-dom/*"],
                    "message": "packages/core is framework-free — see README.md."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
