{
  "name": "@hire-me-mcp/web",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site, chat, and MCP endpoint — the single user-facing Next.js app",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bash ../../scripts/biome-check.sh check .",
    "format": "bash ../../scripts/biome-check.sh format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "generate:connect": "NODE_OPTIONS=--conditions=react-server tsx scripts/generate-connect-cli.ts",
    "generate:connect:check": "NODE_OPTIONS=--conditions=react-server tsx scripts/generate-connect-cli.ts --check",
    "generate:llms": "NODE_OPTIONS=--conditions=react-server tsx scripts/generate-llms-cli.ts",
    "generate:llms:check": "NODE_OPTIONS=--conditions=react-server tsx scripts/generate-llms-cli.ts --check",
    "generate:cv": "NODE_OPTIONS=--conditions=react-server tsx scripts/generate-cv-pdf-cli.ts",
    "generate:cv:full": "CV_MODE=full NODE_OPTIONS=--conditions=react-server tsx scripts/generate-cv-pdf-cli.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.80",
    "@hire-me-mcp/agent": "workspace:*",
    "@hire-me-mcp/career-data": "workspace:*",
    "@hire-me-mcp/connect-metadata": "workspace:*",
    "@hire-me-mcp/core": "workspace:*",
    "@mastra/ai-sdk": "1.9.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "@vercel/analytics": "2.0.1",
    "ai": "7.0.77",
    "mcp-handler": "2.1.1",
    "next": "16.3.3",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mastra/core": "1.61.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.11.6",
    "pdf-parse": "2.4.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
