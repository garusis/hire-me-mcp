{
  "name": "@hire-me-mcp/web",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio site, chat, and MCP endpoint — the single user-facing Next.js app",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bash ../../scripts/biome-check.sh check .",
    "format": "bash ../../scripts/biome-check.sh format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hire-me-mcp/career-data": "workspace:*",
    "@hire-me-mcp/core": "workspace:*",
    "next": "15.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.11.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
