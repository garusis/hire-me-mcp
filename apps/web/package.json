{
  "name": "@hire-me-mcp/web",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio site, chat, and MCP endpoint — the single user-facing Next.js app",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bash ../../scripts/biome-check.sh check .",
    "format": "bash ../../scripts/biome-check.sh format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mcp": "vitest run --config vitest.mcp.config.ts"
  },
  "dependencies": {
    "@hire-me-mcp/agent": "workspace:*",
    "@hire-me-mcp/career-data": "workspace:*",
    "@hire-me-mcp/core": "workspace:*",
    "@mastra/ai-sdk": "1.9.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "ai": "7.0.71",
    "mcp-handler": "2.1.1",
    "next": "15.3.9",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mastra/core": "1.61.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.11.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
