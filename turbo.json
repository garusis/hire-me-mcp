{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@hire-me-mcp/career-data#build": {
      "dependsOn": ["^build", "lint:content"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.base.ts"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.config.base.ts"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@hire-me-mcp/web#typecheck": {
      "dependsOn": ["^build", "@hire-me-mcp/web#build"],
      "outputs": []
    },
    "validate": {
      "outputs": []
    },
    "lint:content": {
      "dependsOn": ["validate"],
      "outputs": []
    },
    "generate:connect": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "generate:connect:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "generate:llms": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "generate:llms:check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
